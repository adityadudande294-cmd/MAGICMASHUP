# ==============================================================================
# Magic Mashup (NexusAI) - Root Environment Configuration Template
# ==============================================================================

# Server Network Configuration (Render automatically sets PORT)
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production

# Allowed CORS Origins (comma-separated). Set to * or your frontend domain
CORS_ORIGINS=*

# AI Model Provider API Keys
# At minimum, provide GEMINI_API_KEY for live responses.
# Missing keys gracefully degrade to the built-in intelligent sandbox engine.
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# Frontend Configuration (Optional)
# Leave blank when frontend is bundled and served directly by FastAPI.
# Set only if frontend is hosted on a separate URL (e.g. https://magicmashup.vercel.app)
VITE_API_BASE_URL=
